# --- Base de données ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=invovix

# --- Sécurité / Auth ---
CORS_ORIGINS=*
JWT_SECRET=change-me-with-a-long-random-string
ADMIN_EMAIL=admin@invovix.store
ADMIN_PASSWORD=change-me

# --- Paiements ---
STRIPE_API_KEY=sk_test_xxx
PAYPAL_CLIENT_ID=xxx
PAYPAL_SECRET=xxx
PAYPAL_MODE=sandbox

# --- CJDropshipping ---
CJ_API_KEY=xxx
CJ_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1

# --- Emails (Brevo) ---
BREVO_API_KEY=xkeysib-xxx
BREVO_SMTP_KEY=xxx
BREVO_SMTP_LOGIN=xxx
BREVO_SENDER_EMAIL=contact@invovix.store
BREVO_SENDER_NAME=Invovix

# --- URLs ---
FRONTEND_URL=https://invovix.store

# --- Anti-bot (Google reCAPTCHA v3) ---
RECAPTCHA_SECRET_KEY=xxx
RECAPTCHA_MIN_SCORE=0.5

# --- IA (clé universelle Emergent) ---
EMERGENT_LLM_KEY=xxx
AI_TEXT_MODEL=gpt-5.4

# --- Notifications SMS/WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=xxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
